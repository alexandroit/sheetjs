{
	"name": "@stackline/xlsx",
	"version": "1.0.6",
	"author": "sheetjs",
	"description": "SheetJS-compatible spreadsheet parser and writer with Stackline security hardening",
	"keywords": [
		"excel",
		"xls",
		"xlsx",
		"xlsb",
		"xlsm",
		"ods",
		"csv",
		"dbf",
		"dif",
		"sylk",
		"office",
		"spreadsheet"
	],
	"main": "xlsx.js",
	"module": "xlsx.mjs",
	"unpkg": "dist/xlsx.full.min.js",
	"jsdelivr": "dist/xlsx.full.min.js",
	"types": "types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./xlsx.mjs",
			"require": "./xlsx.js"
		},
		"./xlsx.mjs": {
			"types": "./types/index.d.ts",
			"import": "./xlsx.mjs"
		},
		"./xlsx.js": {
			"types": "./types/index.d.ts",
			"require": "./xlsx.js"
		},
		"./dist/xlsx.core.min": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.core.min.js",
			"require": "./dist/xlsx.core.min.js"
		},
		"./dist/xlsx.core.min.js": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.core.min.js",
			"require": "./dist/xlsx.core.min.js"
		},
		"./dist/xlsx.full.min": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.full.min.js",
			"require": "./dist/xlsx.full.min.js"
		},
		"./dist/xlsx.full.min.js": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.full.min.js",
			"require": "./dist/xlsx.full.min.js"
		},
		"./dist/xlsx.mini.min": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.mini.min.js",
			"require": "./dist/xlsx.mini.min.js"
		},
		"./dist/xlsx.mini.min.js": {
			"types": "./types/index.d.ts",
			"import": "./dist/xlsx.mini.min.js",
			"require": "./dist/xlsx.mini.min.js"
		},
		"./dist/xlsx.zahl": {
			"types": "./dist/zahl.d.ts",
			"import": "./dist/xlsx.zahl.mjs",
			"require": "./dist/xlsx.zahl.js"
		},
		"./dist/xlsx.zahl.mjs": {
			"types": "./dist/zahl.d.ts",
			"import": "./dist/xlsx.zahl.mjs"
		},
		"./dist/xlsx.zahl.js": {
			"types": "./dist/zahl.d.ts",
			"require": "./dist/xlsx.zahl.js"
		},
		"./dist/cpexcel": {
			"types": "./dist/cpexcel.d.ts",
			"import": "./dist/cpexcel.full.mjs",
			"require": "./dist/cpexcel.js"
		},
		"./dist/cpexcel.js": {
			"types": "./dist/cpexcel.d.ts",
			"require": "./dist/cpexcel.js"
		},
		"./dist/cpexcel.full": {
			"types": "./dist/cpexcel.d.ts",
			"import": "./dist/cpexcel.full.mjs",
			"require": "./dist/cpexcel.js"
		},
		"./dist/cpexcel.full.mjs": {
			"types": "./dist/cpexcel.d.ts",
			"import": "./dist/cpexcel.full.mjs"
		}
	},
	"browser": {
		"buffer": false,
		"crypto": false,
		"stream": false,
		"process": false,
		"fs": false
	},
	"overrides": {
		"diff": "^8.0.3",
		"serialize-javascript": "^7.0.6"
	},
	"sideEffects": false,
	"devDependencies": {
		"@sheetjs/uglify-js": "~2.7.3",
		"@types/node": "^8.5.9",
		"acorn": "^8.17.0",
		"adler-32": "~1.3.1",
		"alex": "^11.0.1",
		"blanket": "~1.2.3",
		"cfb": "~1.2.2",
		"codepage": "~1.15.0",
		"commander": "~2.17.1",
		"crc-32": "~1.2.2",
		"eslint": "^10.5.0",
		"eslint-plugin-html": "^8.1.4",
		"exit-on-epipe": "~1.0.1",
		"fflate": "^0.8.3",
		"jsdom": "^29.1.1",
		"mocha": "^11.7.6",
		"ssf": "~0.11.2",
		"typescript": "^5.9.3",
		"wmf": "~1.0.1",
		"word": "~0.3.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexandroit/sheetjs.git"
	},
	"scripts": {
		"pretest": "npm run lint && npm run metrics:test && npm run package:contract",
		"test": "npm run tests-only",
		"pretest-only": "git submodule init && git submodule update",
		"tests-only": "make travis",
		"build": "make",
		"lint": "make fullint",
		"dtslint": "tsc -p types/tsconfig.json",
		"types-compat": "bash misc/typescript-compat.sh",
		"metrics:test": "node --test misc/npm-version-downloads.test.mjs",
		"metrics:collect": "node misc/npm-version-downloads.mjs",
		"package:contract": "node --test misc/package-contract.test.mjs"
	},
	"config": {
		"blanket": {
			"pattern": "xlsx.js"
		}
	},
	"alex": {
		"allow": [
			"chinese",
			"special",
			"simple",
			"just",
			"crash",
			"wtf",
			"holes"
		]
	},
	"homepage": "https://alexandro.net/docs/vanilla/xlsx/",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"CHANGELOG.md",
		"CONTRIBUTING.md",
		"LICENSE",
		"NOTICE",
		"README.md",
		"SECURITY.md",
		"bower.json",
		"package.json",
		"xlsx.js",
		"xlsx.mjs",
		"xlsxworker.js",
		"dist/LICENSE",
		"dist/*.mjs",
		"dist/*.js",
		"dist/*.map",
		"dist/*.d.ts",
		"types/index.d.ts",
		"types/tsconfig.json"
	],
	"bugs": {
		"url": "https://github.com/alexandroit/sheetjs/issues"
	},
	"license": "Apache-2.0",
	"engines": {
		"node": ">=20"
	},
	"directories": {
		"test": "tests"
	}
}
